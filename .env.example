# Local/operator configuration only. Copy to .env, keep it untracked, and
# chmod 0600. Cloud runtime secrets live in Secret Manager.
SPINE_TOKEN=local-development-token
SPINE_URL=http://localhost:8000
PRINCIPAL_ID=local
MACHINE_ID=local-machine
AGENT_ID=harness-agent
ANTHROPIC_API_KEY=
# Optional direct-provider compatibility; unused by the default broker route.
OPENAI_API_KEY=
# D1 maps this through Secret Manager to Spine's SPINE_OPENAI_API_KEY slot.
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter:minimax/minimax-m3
# Optional. Unset preserves CHAT_MODEL via pinned:<CHAT_MODEL>.
# Other exact A-021 values: max, elbow, slope:<USD-per-M-per-index>, floor:<index>.
# MODEL_POLICY_CHAT=elbow
# Keep this aligned with the pinned model (CHAT_MODEL by default) and static fail-open.
MODEL_CONTEXT_TOKENS=1000000
# Stop a stalled semantic /remember split before it can strand the turn.
REMEMBER_SPLIT_TIMEOUT_SECONDS=30
# Retry extraction for durable transcripts abandoned without archive after this many hours.
EXTRACTION_IDLE_HOURS=24

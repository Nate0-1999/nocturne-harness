    async def test_a_cancelled_turn_stops_its_foreground_command(tmp_path: Path) -> None:
        """F135 (M3EX-13): Ctrl-C mid-turn must not wait on a stuck command, nor orphan it."""
        if not Path("/usr/bin/sandbox-exec").is_file():
